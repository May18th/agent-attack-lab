{
  "name": "frontend-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:production": "npm run build -- --production",
    "predeploy": "npm run build:production",
    "deploy": "npx wrangler deploy",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=1 && node --test scripts/build-environment.node-test.mjs scripts/public-entry.node-test.mjs",
    "build:preview": "node scripts/check-preview-env.mjs && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
