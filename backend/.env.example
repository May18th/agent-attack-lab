# Optional DeepSeek model endpoint for the standalone 8788/8789 agents.
# Copy this file to .env, then set the API key locally. Never commit .env.
# Keep the API key server-side; never expose it through VITE_* variables.
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_TIMEOUT_SECONDS=10
AGENT_LLM_RETRIES=1
AGENT_LLM_MAX_TOKENS=1800

# Optional role-specific attacker/defender endpoints. If all three values for
# a role are blank, that role falls back to the shared AGENT_LLM_* provider.
# Keep credentials server-side; these settings are not exposed to the frontend.
AGENT_ATTACKER_LLM_BASE_URL=
AGENT_ATTACKER_LLM_API_KEY=
AGENT_ATTACKER_LLM_MODEL=
AGENT_ATTACKER_LLM_TIMEOUT_SECONDS=10
AGENT_ATTACKER_LLM_RETRIES=1
AGENT_ATTACKER_LLM_MAX_TOKENS=1800
AGENT_DEFENDER_LLM_BASE_URL=
AGENT_DEFENDER_LLM_API_KEY=
AGENT_DEFENDER_LLM_MODEL=
AGENT_DEFENDER_LLM_TIMEOUT_SECONDS=10
AGENT_DEFENDER_LLM_RETRIES=1
AGENT_DEFENDER_LLM_MAX_TOKENS=1800

# Optional independent LLM reviews. Keep disabled until the corresponding
# prompts and local fallback have been validated in the authorized lab.
AGENT_ARBITER_LLM_ENABLED=0
AGENT_REPORT_LLM_ENABLED=0
# Optional independent Arbiter endpoint; when all three are blank, the shared
# AGENT_LLM_* provider is used. Keep all credentials server-side.
AGENT_ARBITER_LLM_BASE_URL=
AGENT_ARBITER_LLM_API_KEY=
AGENT_ARBITER_LLM_MODEL=
AGENT_ARBITER_LLM_TIMEOUT_SECONDS=10
AGENT_ARBITER_LLM_RETRIES=1
AGENT_ARBITER_LLM_MAX_TOKENS=1800
AGENT_REPORT_LLM_BASE_URL=
AGENT_REPORT_LLM_API_KEY=
AGENT_REPORT_LLM_MODEL=
AGENT_REPORT_LLM_TIMEOUT_SECONDS=10
AGENT_REPORT_LLM_RETRIES=1
AGENT_REPORT_LLM_MAX_TOKENS=1800
AGENT_RULE_DISCOVERY_LLM_ENABLED=0
AGENT_RULE_LLM_BASE_URL=
AGENT_RULE_LLM_API_KEY=
AGENT_RULE_LLM_MODEL=
AGENT_RULE_LLM_TIMEOUT_SECONDS=10
AGENT_RULE_LLM_RETRIES=1
AGENT_RULE_LLM_MAX_TOKENS=1200

# Main 8787 service timeout while waiting for an AIP agent.
AGENT_RPC_TIMEOUT_SECONDS=90
# Retry only transient ACP transport failures; set 0 to disable retries.
AGENT_RPC_RETRIES=2
# Maximum lifetime of one asynchronous battle before it is marked failed.
AGENT_BATTLE_TIMEOUT_SECONDS=300

# Local AIP agent wiring for the main 8787 service.
AGENT_ATTACKER_RPC_URL=http://127.0.0.1:8788/rpc
AGENT_DEFENDER_RPC_URL=http://127.0.0.1:8789/rpc

# Protects the standalone agents' POST /rpc (X-API-Key header) when they are
# exposed through an approved public tunnel.
# The main 8787 service reads the same variable and sends the header on every
# AIP call. Leave empty only for trusted loopback-only development.
AGENT_RPC_API_KEY=

# Standalone Agent identity binding. Leave disabled for local loopback tests;
# production mTLS listeners must set both values from the platform-issued AIC.
AGENT_IDENTITY_BINDING_ENABLED=0
AGENT_LOCAL_AIC=

# Optional browser login for public web clients. Keep both secrets server-side.
AGENT_BROWSER_PASSWORD=
AGENT_BROWSER_SESSION_TTL_SECONDS=28800
AGENT_BROWSER_COOKIE_SECURE=1
AGENT_BROWSER_COOKIE_SAMESITE=lax

# Exact frontend origin(s), comma-separated; required for credentialed browser requests.
# Example: https://yuanyiagentzhandui.cn
AGENT_CORS_ORIGINS=

# Keep the public battle API usable without a browser login. Limit anonymous
# battle creation independently; set 0 only when another rate limiter is used.
AGENT_API_KEY=
AGENT_PROTECT_READS=1
# Reverse proxies on loopback must overwrite X-Real-IP with the client address.
AGENT_PUBLIC_BATTLE_LIMIT_PER_MINUTE=10

# Optional local Redis cache. Keep Redis bound to 127.0.0.1 on the VPS;
# the service falls back to SQLite when this is empty or temporarily down.
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REDIS_TTL_SECONDS=30

# Optional Cloudflare Access verification for protected management endpoints.
# Set both values together; the backend validates Cf-Access-Jwt-Assertion
# against the team JWKS, issuer, audience, and expiry. Do not expose either
# value in VITE_* variables.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
