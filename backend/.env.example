# Optional OpenAI-compatible model endpoint for the standalone 8788/8789 agents.
# Copy this file to .env, then set the API key locally. Never commit .env.
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-flash
AGENT_LLM_TIMEOUT_SECONDS=10
AGENT_LLM_RETRIES=1
AGENT_LLM_MAX_TOKENS=1800

# Main 8787 service timeout while waiting for an AIP agent.
AGENT_RPC_TIMEOUT_SECONDS=90

# Local AIP agent wiring for the main 8787 service.
AGENT_ATTACKER_RPC_URL=http://127.0.0.1:8788/rpc
AGENT_DEFENDER_RPC_URL=http://127.0.0.1:8789/rpc

# Protects the standalone agents' POST /rpc (X-API-Key header) when they are
# exposed through an approved public tunnel.
# The main 8787 service reads the same variable and sends the header on every
# AIP call. Leave empty only for trusted loopback-only development.
AGENT_RPC_API_KEY=

# Standalone Agent identity binding. Leave disabled for local loopback tests;
# production mTLS listeners must set both values from the platform-issued AIC.
AGENT_IDENTITY_BINDING_ENABLED=0
AGENT_LOCAL_AIC=

# Optional browser login for public web clients. Keep both secrets server-side.
AGENT_BROWSER_PASSWORD=
AGENT_BROWSER_SESSION_TTL_SECONDS=28800
AGENT_BROWSER_COOKIE_SECURE=1
AGENT_BROWSER_COOKIE_SAMESITE=lax

# Exact frontend origin(s), comma-separated; required for credentialed browser requests.
# Example: https://yuanyiagentzhandui.cn
AGENT_CORS_ORIGINS=

# For a public browser deployment, configure both secrets and protect reads.
AGENT_API_KEY=
AGENT_PROTECT_READS=1
