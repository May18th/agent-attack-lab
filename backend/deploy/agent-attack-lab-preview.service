[Unit]
Description=Agent Attack Lab isolated Preview API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-attack-lab/backend
EnvironmentFile=/home/deployer/.config/agent-attack-lab/preview.env
ExecStart=/opt/agent-attack-lab/backend/.venv/bin/python -m uvicorn agent_attack_lab.service:app --host 127.0.0.1 --port 8790 --log-level warning
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
