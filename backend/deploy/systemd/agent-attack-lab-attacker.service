[Unit]
Description=Agent Attack Lab Attacker Agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-attack-lab/backend
ExecStart=/opt/agent-attack-lab/backend/scripts/start-service.sh agent_attack_lab.agents.attacker:app 8788
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
